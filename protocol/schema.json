              "exclusiveMinimum": 0
            },
            "tableTop": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tableThickness": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "friction": {
              "type": "number",
              "minimum": 0
