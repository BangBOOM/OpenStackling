{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackling.local/protocol/schema.json",
  "$defs": {
    "protocol": {
      "const": "stackling.policy"
    },
    "profile": {
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "environmentFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "config": {
          "$ref": "#/$defs/config"
        },
        "io": {
          "type": "object",
          "properties": {
            "rgb": {
              "const": "png-rgb8"
            },
            "depth": {
              "const": "gzip-u16le-mm-zero-invalid"
            },
            "action": {
              "const": "absolute-joints-rad-gap-m"
            },
            "state": {
              "const": "measured-joints-rad-gap-m"
            }
          },
          "required": [
            "rgb",
            "depth",
            "action",
            "state"
          ],
          "additionalProperties": false
        },
        "trainingAppearance": {
          "$ref": "#/$defs/appearance"
        },
        "trainingTasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskCase"
          }
        }
      },
      "required": [
        "profileId",
        "environmentFingerprint",
        "config",
        "io",
        "trainingAppearance",
        "trainingTasks"
      ],
      "additionalProperties": false
    },
